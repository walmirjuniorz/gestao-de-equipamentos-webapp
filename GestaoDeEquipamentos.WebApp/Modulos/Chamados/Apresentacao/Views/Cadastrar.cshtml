@model CadastrarChamadoViewModel

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Cadastro de Chamado";

    <div class="row justify-content-start">
        <form class="col-lg-6" asp-action="Cadastrar" method="post">
            <div>
                <label class="form-label" asp-for="Titulo">Título</label>
                <input class="form-control" asp-for="Titulo" type="text">
                <span class="text-danger" asp-validation-for="Titulo"></span>
            </div>

            <div class="mt-4">
                <label class="form-label" asp-for="Descricao">Descrição</label>
                <textarea class="form-control" asp-for="Descricao"></textarea>
                <span class="text-danger" asp-validation-for="Descricao"></span>
            </div>

            <div class="mt-4">
                <label class="form-label" asp-for="EquipamentoId">Equipamento</label>
                <select class="form-select" asp-for="EquipamentoId">
                    <option value="0">Selecione um Equipamento</option>
                    @foreach (SelecionarEquipamentoViewModel fabricante in Model.EquipamentosDisponiveis!)
                    {
                        <option value="@fabricante.Id">@fabricante.Nome</option>
                    }
                </select>
                <span class="text-danger" asp-validation-for="EquipamentoId"></span>
            </div>

            <div class="d-flex gap-3 mt-4">
                <button class="btn btn-primary" type="submit">
                    <i class="bi bi-check"></i>
                    Cadastrar
                </button>
                <a class="btn btn-outline-secondary" asp-action="Listar">
                    <i class="bi bi-arrow-return-left"></i>
                    Voltar para a lista
                </a>
            </div>
        </form>
    </div>
}