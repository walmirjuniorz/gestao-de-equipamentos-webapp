@model ExcluirEquipamentoViewModel

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Exclusão de Equipamento";
}

<div class="row justify-content-start">
    <form class="col-lg-6" asp-action="Excluir" asp-route-id="@Model.Id" method="post">
        <input asp-for="Id" type="hidden">

        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        <div class="alert alert-danger mt-4" role="alert">
            Você deseja realmente excluir o registro "@Model.Nome"? Esta ação é irreversível.
        </div>

        <div class="d-flex gap-3 mt-4">
            <button class="btn btn-danger" type="submit">
                <i class="bi bi-check"></i>
                Confirmar Exclusão
            </button>
            <a class="btn btn-outline-secondary" asp-action="Listar">
                <i class="bi bi-arrow-return-left"></i>
                Voltar para a lista
            </a>
        </div>
    </form>
</div>
